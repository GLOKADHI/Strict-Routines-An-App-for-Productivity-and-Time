{
  "manifest_version": 3,
  "name": "StrictRoutines Status Helper",
  "version": "1.3.0",
  "minimum_chrome_version": "120",
  "description": "Visible, profile-bound status checks for the StrictRoutines extension; no browsing data collected.",
  "key": "",
  "permissions": [
    "management",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
